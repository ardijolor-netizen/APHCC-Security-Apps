# ===========================================
# APHCC Security Apps - Environment Variables
# ===========================================

# --- Firebase (Web config) ---
# Masukkan nilai dari Firebase Console > Project settings > Config
NEXT_PUBLIC_FIREBASE_API_KEY=api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=app-id

# --- Firebase Admin (Server-side) ---
# File serviceAccountKey.json (di server, bukan di browser)
# FIREBASE_SERVICE_ACCOUNT_KEY=Path ke file serviceAccountKey.json

# --- Neon Database ---
# Ditekan dari Neon Console > Connection Strings > Connection String
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Jangan di-share ke orang lain!
# NEXT_PUBLIC_NEON_DATABASE_URL=postgres://...

# --- App ---
# BASE_URL=http://localhost:3000
